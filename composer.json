{
  "name": "ablogcms/testing-framework",
  "description": "Testing framework for a-blog cms plugins",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "phpunit/phpunit": "^10.5",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "Acms\\TestingFramework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Acms\\TestingFramework\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/acms-create-database"
  ],
  "config": {
    "sort-packages": true
  }
}
